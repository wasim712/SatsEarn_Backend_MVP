generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum Role {
  USER
  SUPER_ADMIN
}

enum Tier {
  BASIC
  BRONZE
  SILVER
  GOLD
}

enum TaskCategory {
  SOCIAL
  SURVEY
  VIDEO_AD
  APP_INSTALL
  OFFERWALL
  LEARN_EARN
  DAILY_STREAK
}

enum SubmissionStatus {
  PENDING_24H      // AI verified, waiting for 24-hour re-check
  LOCKED_15D        // Re-verified, sitting in 15-day security hold
  WITHDRAWABLE      // 15 days passed, funds are available
  MANUAL_REVIEW     // AI flagged it (score 70-89)
  REJECTED          // Auto-rejected (score <70) or Admin rejected
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  PROMOTION
}

// --- MODELS ---

model User {
  id               String   @id @default(uuid())
  supabaseAuthId   String   @unique 
  email            String   @unique
  phone            String?  @unique
  role             Role     @default(USER)
  
  // Basic KYC
  fullName         String?
  country          String?  // Locked after signup
  dateOfBirth      DateTime?
  
  // Balances (Sats)
  balanceAvailable Int      @default(0) // Ready for withdrawal
  balancePending   Int      @default(0) // In verification/hold
  balanceLocked    Int      @default(0) // Any specifically locked bonus funds

  // Gamification & Stats
  tier             Tier     @default(BASIC)
  xp               Int      @default(0)
  level            Int      @default(0)
  currentStreak    Int      @default(0)
  lastActivityAt   DateTime @default(now())
  
  // Connected Social Accounts
  twitterHandle    String?
  instagramHandle  String?
  telegramHandle   String?
  discordHandle    String?

  // Referral System
  referralCode     String   @unique
  referredById     String?
  referredBy       User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("UserReferrals")

  // Relations
  submissions      Submission[]
  withdrawals      Withdrawal[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PlatformSettings {
  id                  String   @id @default(uuid())
  
  // Economics
  welcomeBonusSats    Int      @default(50)
  minWithdrawalSats   Int      @default(25000)
  securityLockDays    Int      @default(15)
  
  // Gamification & XP
  baseXpPerTask       Int      @default(10)
  dailyStreakBonusXp  Int      @default(5)

  updatedAt           DateTime @updatedAt
}

model Campaign {
  id                 String       @id @default(uuid())
  title              String
  description        String
  category           TaskCategory
  
  targetUrl          String?
  socialHandleTarget String?      
  targetCountries    String[]     
  requiredTier       Tier         @default(BASIC)
  
  rewardSats         Int
  totalCompletions   Int          @default(0)
  maxCompletions     Int          
  
  isActive           Boolean      @default(true)
  
  tasks              Task[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Task {
  id                 String       @id @default(uuid())
  campaignId         String
  campaign           Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  title              String?      
  description        String?
  targetUrl          String?
  rewardSatsOverride Int?         

  submissions        Submission[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Submission {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id])
  
  screenshotUrl    String           
  imageHash        String?          
  ocrExtractedText String?          @db.Text 
  
  confidenceScore  Int              @default(0)
  status           SubmissionStatus @default(PENDING_24H)
  rejectionReason  String?
  
  submittedAt      DateTime         @default(now())
  reverifyAt       DateTime?        
  unlockAt         DateTime?        
  
  @@unique([userId, taskId])
}

model Withdrawal {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  
  amountSats      Int
  lightningInvoice String?         @db.Text // Store BOLT11 invoice or address
  status          WithdrawalStatus @default(PENDING)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  content   String           @db.Text
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}