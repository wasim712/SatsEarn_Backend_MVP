generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS: The Rules of the System
// ==========================================

enum Role {
  USER
  SUPER_ADMIN
}

// Free tiers are earned strictly via totalXp grinding
enum FreeTier {
  BASIC
  COPPER
  BRONZE
  SILVER
  GOLD
}

// Premium tiers are bought and sit "on top" of free tiers
enum PremiumTier {
  PLATINUM
  DIAMOND
  CROWN
  ELITE
  FOUNDER
}

enum TaskCategory {
  SOCIAL
  SURVEY
  VIDEO_AD
  APP_INSTALL
  OFFERWALL
  LEARN_EARN
  DAILY_STREAK
}

enum SubmissionStatus {
  PENDING_24H      // AI verified, waiting for 24-hour hold
  LOCKED_15D       // Passed 24h, sitting in 15-day security lock
  WITHDRAWABLE     // 15 days passed, funds moved to Available
  MANUAL_REVIEW    // AI flagged it (score 70-89)
  REJECTED         // Auto-rejected (score <70) or Admin rejected
}

enum WithdrawalStatus {
  PENDING          // User requested, waiting for Admin to pay
  PAID             // Admin paid via Lightning Network
  REJECTED         // Admin rejected (e.g., invalid Wallet ID)
}

enum TransactionType {
  TASK_REWARD
  REFERRAL_BONUS
  WITHDRAWAL
  WELCOME_BONUS
  PENALTY
  STREAK_BONUS
  DAILY_QUIZ_REWARD
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  PROMOTION
}

// ==========================================
// MODELS: The Data Architecture
// ==========================================

model User {
id               String   @id @default(uuid())
  
  // --- CUSTOM AUTHENTICATION ---
  email            String   @unique
  passwordHash     String?  // Stores the securely hashed password
  authProvider     String   @default("EMAIL") 
  isVerified       Boolean  @default(false) // Blocks login until OTP is entered
  
  // --- OTP MANAGEMENT ---
  otpCode          String?  // Stores the 6-digit code
  otpExpiresAt     DateTime?// Ensures the code dies after 15 minutes
  
  avatarUrl        String?  
  phone            String?  @unique
  role             Role     @default(USER)
  
  // --- BASIC KYC ---
  fullName         String?  
  country          String?  
  dateOfBirth      DateTime?
  username         String?  @unique

  // --- GAMIFICATION & ECONOMY ---
  balanceAvailable Int      @default(0) 
  balancePending   Int      @default(0) 
  balanceLocked    Int      @default(0) 

  totalXp          Int      @default(0) 
  premiumTier      PremiumTier?         
  premiumExpiresAt DateTime?            

  currentStreak    Int      @default(0)
  lastActivityAt   DateTime @default(now())
  
  // --- CONNECTED SOCIAL ACCOUNTS ---
  twitterHandle    String?
  instagramHandle  String?
  telegramHandle   String?
  discordHandle    String?

  // --- REFERRAL SYSTEM ---
  referralCode     String   @unique
  referredById     String?
  referredBy       User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("UserReferrals")

  // --- RELATIONS ---
  submissions      Submission[]
  withdrawals      Withdrawal[]
  transactions     Ledger[]     
  quizAttempts     QuizAttempt[]
  
  isActive         Boolean  @default(true) // The Soft Delete Flag
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([role])
}

// ------------------------------------------
// FINANCIAL LOGIC: The Audit Trail
// ------------------------------------------

model Ledger {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  
  amountSats    Int             // Positive (Income) or Negative (Withdrawal)
  type          TransactionType
  description   String?         
  
  // Reference to the Submission ID or Withdrawal ID that triggered this
  referenceId   String?         
  
  createdAt     DateTime        @default(now())

  @@index([userId, type])
}

// ------------------------------------------
// SYSTEM RULES
// ------------------------------------------

model PlatformSettings {
  id                   String   @id @default(uuid())
  
  welcomeBonusSats     Int      @default(50)
  minWithdrawalSats    Int      @default(25000)
  securityLockDays     Int      @default(15)
  referralBonusPercent Int      @default(5) // Default for Free users
  
  baseXpPerTask        Int      @default(10)
  dailyStreakBonusXp   Int      @default(5)

  updatedAt            DateTime @updatedAt
}

// ------------------------------------------
// CAMPAIGNS & TASKS
// ------------------------------------------

model Campaign {
  id                 String       @id @default(uuid())
  title              String
  description        String
  category           TaskCategory
  
  targetUrl          String?
  socialHandleTarget String?      
  targetCountries    String[]     
  
  // --- THE ACCESS GATES ---
  requiredFreeTier   FreeTier     @default(BASIC) // E.g., "Must be at least Silver"
  isPremiumOnly      Boolean      @default(false) // E.g., "Must hold ANY paid subscription"
  
  // --- THE ECONOMICS (Explicit Pricing Matrix) ---
  baseRewardSats     Int          // The anchor for calculating referral commissions
  tierRewardMatrix   Json         // Stores exact Sats for all 10 tiers e.g. {"BASIC": 10, ..., "FOUNDER": 50}
  
  totalCompletions   Int          @default(0)
  maxCompletions     Int          
  
  isActive           Boolean      @default(true)
  
  tasks              Task[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([isActive, isPremiumOnly, requiredFreeTier]) 
}

model Task {
  id                       String       @id @default(uuid())
  campaignId               String
  campaign                 Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  title                    String?      
  description              String?
  targetUrl                String?
  
  // Allows a specific task in a campaign to have a different economy than the campaign default
  baseRewardSatsOverride   Int?         
  tierRewardMatrixOverride Json?        
  
  // Flexible rules (e.g., {"minFollowers": 100}) for the AI Prompt
  requirements             Json?        

  submissions              Submission[]
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

// ------------------------------------------
// PROOF & AI ENGINE
// ------------------------------------------

model Submission {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id])
  
  // Storage & Verification
  screenshotUrl    String            
  imageHash        String?          // For duplicate detection
  ocrExtractedText String?          @db.Text 
  
  // AI Decisions
  confidenceScore  Int              @default(0)
  status           SubmissionStatus @default(PENDING_24H)
  rejectionReason  String?
  
  // Accountability
  reviewedById     String?          // Which Admin manually approved/rejected this

  // Timestamps for Cron Jobs
  submittedAt      DateTime         @default(now())
  reverifyAt       DateTime?        
  unlockAt         DateTime?        
  
  @@unique([userId, taskId])
  @@index([status]) 
  @@index([imageHash]) 
}

// ------------------------------------------
// MONEY OUT: Withdrawals & Wallets
// ------------------------------------------

model Withdrawal {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  
  amountSats       Int
  
  // THE WALLET ID: Where the user wants the money sent
  lightningInvoice String           @db.Text 
  
  // THE RECEIPT: The Admin pastes the Tx Hash here after paying
  paymentProof     String?          
  
  status           WithdrawalStatus @default(PENDING)
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  content   String           @db.Text
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ==========================================
// DAILY QUIZ GAMIFICATION ENGINE
// ==========================================

model DailyQuiz {
  id         String   @id @default(uuid())
  
  // The specific calendar day for this quiz (Ensures only 1 quiz per day)
  date       DateTime @unique @db.Date 
  
  title      String   // e.g., "Bitcoin Basics: The Halving"
  rewardSats Int      @default(10) // Small dopamine hit
  isActive   Boolean  @default(true)

  questions  QuizQuestion[]
  attempts   QuizAttempt[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model QuizQuestion {
  id            String   @id @default(uuid())
  
  dailyQuizId   String
  dailyQuiz     DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)
  
  questionText  String   @db.Text
  options       String[] // ["21 Million", "Unlimited", "100 Million"]
  correctAnswer String   
  
  order         Int      @default(0) 

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dailyQuizId])
}

// Tracks who took the quiz so they can't double-dip
model QuizAttempt {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  dailyQuizId String
  dailyQuiz   DailyQuiz @relation(fields: [dailyQuizId], references: [id])
  
  score       Int
  passed      Boolean  // True if they got 100%

  createdAt   DateTime @default(now())

  // Critical: Prevents a user from submitting the same daily quiz twice
  @@unique([userId, dailyQuizId]) 
}