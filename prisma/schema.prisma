generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS: The Rules of the System
// ==========================================

enum Role {
  USER
  SUPER_ADMIN
}

// Free tiers are earned strictly via totalXp grinding
enum FreeTier {
  BASIC
  COPPER
  BRONZE
  SILVER
  GOLD
}

// Premium tiers are bought and sit "on top" of free tiers
enum PremiumTier {
  PLATINUM
  DIAMOND
  CROWN
  ELITE
  FOUNDER
}

enum TaskCategory {
  SOCIAL
  SURVEY
  VIDEO_AD
  APP_INSTALL
  OFFERWALL
  LEARN_EARN
  DAILY_STREAK
}
enum CampaignDevice {
  NONE
  DESKTOP
  ANDROID
  IOS
}

enum TaskPlatform {
  TWITTER
  YOUTUBE
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  LINKEDIN
  APP_STORE
  PLAY_STORE
  WEBSITE
}
enum ProofType {
  SCREENSHOT
  URL
  TEXT_RESPONSE
  API_VERIFIED
}
enum SubmissionStatus {
  PENDING_24H      // AI verified, waiting for 24-hour hold
  LOCKED_15D       // Passed 24h, sitting in 15-day security lock
  WITHDRAWABLE     // 15 days passed, funds moved to Available
  MANUAL_REVIEW    // AI flagged it (score 70-89)
  REJECTED         // Auto-rejected (score <70) or Admin rejected
}

enum WithdrawalStatus {
  PENDING          // User requested, waiting for Admin to pay
  PAID             // Admin paid via Lightning Network
  REJECTED         // Admin rejected (e.g., invalid Wallet ID)
}

enum TransactionType {
  TASK_REWARD
  REFERRAL_BONUS
  WITHDRAWAL
  WELCOME_BONUS
  PENALTY
  STREAK_BONUS
  DAILY_QUIZ_REWARD
  MINIGAME_XP_REWARD
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  PROMOTION
}

enum NotificationType {
  // User Notifications
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  SYSTEM_ALERT

  // Admin Notifications
  NEW_SUBMISSION
  NEW_WITHDRAWAL
}

enum BugReportStatus {
  OPEN
  REWARDED
  REJECTED
}

enum PremiumRequestIntent {
  NOTIFY_ME
  UPGRADE
}

enum PremiumRequestStatus {
  OPEN
  CONTACTED
  COMPLETED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum BillingSource {
  MANUAL_PAYMENT
  SATS_BALANCE
  ADMIN_OVERRIDE
}


// ==========================================
// MODELS: The Data Architecture
// ==========================================

model User {
id               String   @id @default(uuid())
  
  // --- CUSTOM AUTHENTICATION ---
  email            String   @unique
  passwordHash     String?  // Stores the securely hashed password
  authProvider     String   @default("EMAIL") 
  isVerified       Boolean  @default(false) // Blocks login until OTP is entered
  
  // --- OTP MANAGEMENT ---
  otpCode          String?  // Stores the 6-digit code
  otpExpiresAt     DateTime?// Ensures the code dies after 15 minutes
  
  avatarUrl        String?  
  phone            String?  @unique
  role             Role     @default(USER)
  
  // --- BASIC KYC ---
  fullName         String?  
  country          String?  
  dateOfBirth      DateTime?
  username         String?  @unique

  // --- GAMIFICATION & ECONOMY ---
  balanceAvailable Int      @default(0) 
  balancePending   Int      @default(0) 
  balanceLocked    Int      @default(0) 
  referralPendingMsats Int  @default(0)

  totalXp          Int      @default(0) 
  premiumTier      PremiumTier?         
  premiumExpiresAt DateTime?            
  queuedPremiumTier PremiumTier?
  queuedPremiumStartsAt DateTime?
  queuedPremiumExpiresAt DateTime?

  currentStreak    Int      @default(0)
  lastClaimedStreakMilestone Int @default(0)
  lastActivityAt   DateTime @default(now())
  registrationIp   String?  // The IP they used to create the account
  lastIpAddress    String?  // The IP they last logged in with
  hasCompletedOnboarding Boolean @default(false)
  onboardingCompletedAt DateTime?
  hasSkippedOnboarding Boolean @default(false)
  onboardingSkippedAt DateTime?
  // --- CONNECTED SOCIAL ACCOUNTS ---
  twitterHandle    String?
  instagramHandle  String?
  telegramHandle   String?
  discordHandle    String?

  // --- REFERRAL SYSTEM ---
  referralCode     String   @unique
  referredById     String?
  referredBy       User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("UserReferrals")

  // --- RELATIONS ---
  submissions      Submission[]
  standaloneSubmissions StandaloneSubmission[]
  withdrawals      Withdrawal[]
  transactions     Ledger[]     
  quizAttempts     QuizAttempt[]
  notifications    Notification[]
  bugReports       BugReport[]
  premiumRequests  PremiumRequest[]
  billingRecords   BillingRecord[]
  
  isActive         Boolean  @default(true) // The Soft Delete Flag
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([role])
}

// ------------------------------------------
// FINANCIAL LOGIC: The Audit Trail
// ------------------------------------------

model Ledger {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  
  amountSats    Int             // Positive (Income) or Negative (Withdrawal)
  amountMsats   Int?
  type          TransactionType
  description   String?         
  
  // Reference to the Submission ID or Withdrawal ID that triggered this
  referenceId   String?         
  
  createdAt     DateTime        @default(now())

  @@index([userId, type])
}

// ------------------------------------------
// SYSTEM RULES
// ------------------------------------------

model PlatformSettings {
  id                   String   @id @default(uuid())
  welcomeBonusSats     Int      @default(50)
  minWithdrawalSats    Int      @default(25000)
  securityLockDays     Int      @default(15)
  
  // The old global fallback
  referralBonusPercent Int      @default(5) 
  
  // ÃƒÂ°Ã…Â¸Ã…Â¡Ã¢â€šÂ¬ NEW: The exact % commission based on the referrer's tier
  tierReferralMatrix   Json?    
  tierMinWithdrawalMatrix Json?
  premiumMonthlySatsMatrix Json?
  premiumYearlySatsMatrix  Json?
  premiumMonthlyUsdMatrix  Json?
  premiumYearlyUsdMatrix   Json?
  btcPriceUsd             Float   @default(90000)
  userSidebarConfig     Json?

  baseXpPerTask        Int      @default(10)
  dailyStreakBonusXp   Int      @default(5)
  updatedAt            DateTime @updatedAt
}

model StandaloneTask {
  id                   String         @id @default(uuid())
  title                String
  description          String
  category             TaskCategory   @default(SOCIAL)
  coverImageUrl        String?
  targetUrl            String?
  targetCountries      String[]
  isPremiumOnly        Boolean        @default(false)
  requiredFreeTier     FreeTier       @default(BASIC)
  requiredPlatform     CampaignDevice @default(NONE)
  proofType            ProofType      @default(SCREENSHOT)
  isNewUserOnly        Boolean        @default(false)
  newUserMaxAccountAgeDays Int?
  xpReward             Int            @default(0)
  tierRewardMatrix     Json
  doubleRewardsStartAt DateTime?
  doubleRewardsEndAt   DateTime?
  isActive             Boolean        @default(true)
  submissions          StandaloneSubmission[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([isActive, createdAt])
}

model StandaloneSubmission {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  standaloneTaskId String
  standaloneTask   StandaloneTask   @relation(fields: [standaloneTaskId], references: [id], onDelete: Cascade)
  ipAddress        String?
  screenshotUrl    String?
  proofText        String?          @db.Text
  imageHash        String?
  ocrExtractedText String?          @db.Text
  confidenceScore  Int              @default(0)
  status           SubmissionStatus @default(PENDING_24H)
  rejectionReason  String?
  reviewedById     String?
  submittedAt      DateTime         @default(now())
  reverifyAt       DateTime?
  unlockAt         DateTime?

  @@unique([userId, standaloneTaskId])
  @@index([status])
  @@index([imageHash])
}

model BillingRecord {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  premiumTier        PremiumTier
  billingCycle       BillingCycle
  billingSource      BillingSource
  amountUsd          Float?
  amountSats         Int?
  adminNotes         String?       @db.Text
  premiumExpiresAt   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId, createdAt])
}

// ------------------------------------------
// CAMPAIGNS & TASKS
// ------------------------------------------

model Campaign {
  id                 String       @id @default(uuid())
  title              String
  description        String
  category           TaskCategory
  coverImageUrl      String?
  
  targetUrl          String?
  socialHandleTarget String?      
  targetCountries    String[]     
  requiredPlatform   CampaignDevice @default(NONE)
  
  // --- THE ACCESS GATES ---
  requiredFreeTier   FreeTier     @default(BASIC) // E.g., "Must be at least Silver"
  isPremiumOnly      Boolean      @default(false) // E.g., "Must hold ANY paid subscription"
  isNewUserOnly      Boolean      @default(false)
  newUserMaxAccountAgeDays Int?
  
  // --- THE ECONOMICS (Explicit Pricing Matrix) ---
  baseRewardSats     Int          // The anchor for calculating referral commissions
  tierRewardMatrix   Json         // Stores exact Sats for all 10 tiers e.g. {"BASIC": 10, ..., "FOUNDER": 50}
  xpReward           Int          @default(0)
  doubleRewardsStartAt DateTime?
  doubleRewardsEndAt   DateTime?
  maxCompletions     Int
  totalCompletions   Int          @default(0)
  
  isActive           Boolean      @default(true)
  
  tasks              Task[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([isActive, isPremiumOnly, requiredFreeTier]) 
}

model Task {
  id                       String       @id @default(uuid())
  campaignId               String
  campaign                 Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  title                    String?      
  description              String?
  targetUrl                String?
  proofType                ProofType    @default(SCREENSHOT)
  baseRewardSatsOverride   Int?         
  tierRewardMatrixOverride Json?        
  xpRewardOverride         Int?

  requirements             Json?        

  submissions              Submission[]
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

// ------------------------------------------
// PROOF & AI ENGINE
// ------------------------------------------

model Submission {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id])
  ipAddress        String?
  // ÃƒÂ°Ã…Â¸Ã…Â¡Ã¢â€šÂ¬ CHANGED: Made optional (Added '?') because text responses don't have images!
  screenshotUrl    String?          
  
  // ÃƒÂ°Ã…Â¸Ã…Â¡Ã¢â€šÂ¬ NEW: Where we store the URL or Text Response from the user
  proofText        String?          @db.Text
  
  imageHash        String?          
  ocrExtractedText String?          @db.Text 
  
  confidenceScore  Int              @default(0)
  status           SubmissionStatus @default(PENDING_24H)
  rejectionReason  String?
  
  reviewedById     String?          

  submittedAt      DateTime         @default(now())
  reverifyAt       DateTime?        
  unlockAt         DateTime?        
  
  @@unique([userId, taskId])
  @@index([status]) 
  @@index([imageHash]) 
}

// ------------------------------------------
// MONEY OUT: Withdrawals & Wallets
// ------------------------------------------

model Withdrawal {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  
  amountSats       Int
  
  // THE WALLET ID: Where the user wants the money sent
  lightningInvoice String           @db.Text 
  
  // THE RECEIPT: The Admin pastes the Tx Hash here after paying
  paymentProof     String?          
  
  status           WithdrawalStatus @default(PENDING)
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  content   String           @db.Text
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model BlogPost {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  excerpt      String?  @db.Text
  content      String   @db.Text
  coverImageUrl String?
  isPublished  Boolean  @default(false)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model FaqItem {
  id         String   @id @default(uuid())
  question   String
  answer     String   @db.Text
  category   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ==========================================
// DAILY QUIZ GAMIFICATION ENGINE
// ==========================================

model DailyQuiz {
  id         String   @id @default(uuid())
  
  // The specific calendar day for this quiz (Ensures only 1 quiz per day)
  date       DateTime @unique @db.Date 
  
  title      String   // e.g., "Bitcoin Basics: The Halving"
  rewardSats Int      @default(10) // Small dopamine hit
  xpReward   Int      @default(0)
  isActive   Boolean  @default(true)

  questions  QuizQuestion[]
  attempts   QuizAttempt[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model QuizQuestion {
  id            String   @id @default(uuid())
  
  dailyQuizId   String
  dailyQuiz     DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)
  
  questionText  String   @db.Text
  explanation   String?  @db.Text
  options       String[] // ["21 Million", "Unlimited", "100 Million"]
  correctAnswer String   
  
  order         Int      @default(0) 

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dailyQuizId])
}

// Tracks who took the quiz so they can't double-dip
model QuizAttempt {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  dailyQuizId String
  dailyQuiz   DailyQuiz @relation(fields: [dailyQuizId], references: [id])

  answers     Json?
  
  score       Int
  passed      Boolean  // True if they got 100%

  createdAt   DateTime @default(now())

  // Critical: Prevents a user from submitting the same daily quiz twice
  @@unique([userId, dailyQuizId]) 
}
model Notification {
  id          String           @id @default(uuid())
  
  // Who gets it? 
  userId      String?          // If null and forAdmin is true, ALL admins see it
  user        User?            @relation(fields: [userId], references: [id])
  forAdmin    Boolean          @default(false)

  title       String
  message     String           @db.Text
  type        NotificationType
  
  isRead      Boolean          @default(false)
  referenceId String?          // Helpful to link directly to a task or withdrawal ID

  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
  @@index([forAdmin, isRead])
}

model PremiumRequest {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  plan            PremiumTier
  intent          PremiumRequestIntent
  status          PremiumRequestStatus @default(OPEN)
  source          String?
  userEmail       String
  userFullName    String?
  userActiveTier  String
  adminNotes      String?
  contactedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([userId, plan, intent, status])
  @@index([status, createdAt])
}

model BugReport {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  screenshotUrl   String?
  status          BugReportStatus @default(OPEN)
  rewardSats      Int             @default(0)
  adminNotes      String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

