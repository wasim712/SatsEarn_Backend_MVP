generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS: The Rules of the System
// ==========================================

enum Role {
  USER
  SUPER_ADMIN
}

enum Tier {
  BASIC
  BRONZE
  SILVER
  GOLD
}

enum TaskCategory {
  SOCIAL
  SURVEY
  VIDEO_AD
  APP_INSTALL
  OFFERWALL
  LEARN_EARN
  DAILY_STREAK
}

enum SubmissionStatus {
  PENDING_24H      // AI verified, waiting for 24-hour hold
  LOCKED_15D       // Passed 24h, sitting in 15-day security lock
  WITHDRAWABLE     // 15 days passed, funds moved to Available
  MANUAL_REVIEW    // AI flagged it (score 70-89)
  REJECTED         // Auto-rejected (score <70) or Admin rejected
}

enum WithdrawalStatus {
  PENDING          // User requested, waiting for Admin to pay
  PAID             // Admin paid via Lightning Network
  REJECTED         // Admin rejected (e.g., invalid Wallet ID)
}

enum TransactionType {
  TASK_REWARD
  REFERRAL_BONUS
  WITHDRAWAL
  WELCOME_BONUS
  PENALTY
  STREAK_BONUS
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  PROMOTION
}

// ==========================================
// MODELS: The Data Architecture
// ==========================================

model User {
  id               String   @id @default(uuid())
  supabaseAuthId   String   @unique 
  email            String   @unique
  phone            String?  @unique
  role             Role     @default(USER)
  
  // Basic KYC
  fullName         String?
  country          String?  
  dateOfBirth      DateTime?
  
  // THE TRIPLE-BALANCE SYSTEM (Stored in Sats)
  balanceAvailable Int      @default(0) // Safe to withdraw
  balancePending   Int      @default(0) // Stuck in 24h or 15d lock
  balanceLocked    Int      @default(0) // Welcome bonuses or special locked funds

  // Gamification & Stats
  tier             Tier     @default(BASIC)
  xp               Int      @default(0)
  level            Int      @default(0)
  currentStreak    Int      @default(0)
  lastActivityAt   DateTime @default(now())
  
  // Connected Social Accounts
  twitterHandle    String?
  instagramHandle  String?
  telegramHandle   String?
  discordHandle    String?

  // Referral System
  referralCode     String   @unique
  referredById     String?
  referredBy       User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("UserReferrals")

  // Relations
  submissions      Submission[]
  withdrawals      Withdrawal[]
  transactions     Ledger[]     
  isActive         Boolean  @default(true) // The Soft Delete Flag
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([role])
}

// ------------------------------------------
// FINANCIAL LOGIC: The Audit Trail
// ------------------------------------------

model Ledger {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  
  amountSats    Int             // Positive (Income) or Negative (Withdrawal)
  type          TransactionType
  description   String?         
  
  // Reference to the Submission ID or Withdrawal ID that triggered this
  referenceId   String?         
  
  createdAt     DateTime        @default(now())

  @@index([userId, type])
}

// ------------------------------------------
// SYSTEM RULES
// ------------------------------------------

model PlatformSettings {
  id                   String   @id @default(uuid())
  
  welcomeBonusSats     Int      @default(50)
  minWithdrawalSats    Int      @default(25000)
  securityLockDays     Int      @default(15)
  referralBonusPercent Int      @default(5) 
  
  baseXpPerTask        Int      @default(10)
  dailyStreakBonusXp   Int      @default(5)

  updatedAt            DateTime @updatedAt
}

// ------------------------------------------
// CAMPAIGNS & TASKS
// ------------------------------------------

model Campaign {
  id                 String       @id @default(uuid())
  title              String
  description        String
  category           TaskCategory
  
  targetUrl          String?
  socialHandleTarget String?      
  targetCountries    String[]     
  requiredTier       Tier         @default(BASIC)
  
  rewardSats         Int
  totalCompletions   Int          @default(0)
  maxCompletions     Int          
  
  isActive           Boolean      @default(true)
  
  tasks              Task[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([isActive, requiredTier]) 
}

model Task {
  id                 String       @id @default(uuid())
  campaignId         String
  campaign           Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  title              String?      
  description        String?
  targetUrl          String?
  rewardSatsOverride Int?         
  
  // Flexible rules (e.g., {"minFollowers": 100})
  requirements       Json?        

  submissions        Submission[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// ------------------------------------------
// PROOF & AI ENGINE
// ------------------------------------------

model Submission {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id])
  
  // Storage & Verification
  screenshotUrl    String           
  imageHash        String?          // For duplicate detection
  ocrExtractedText String?          @db.Text 
  
  // AI Decisions
  confidenceScore  Int              @default(0)
  status           SubmissionStatus @default(PENDING_24H)
  rejectionReason  String?
  
  // Accountability
  reviewedById     String?          // Which Admin manually approved/rejected this

  // Timestamps for Cron Jobs
  submittedAt      DateTime         @default(now())
  reverifyAt       DateTime?        
  unlockAt         DateTime?        
  
  @@unique([userId, taskId])
  @@index([status]) 
  @@index([imageHash]) 
}

// ------------------------------------------
// MONEY OUT: Withdrawals & Wallets
// ------------------------------------------

model Withdrawal {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  
  amountSats       Int
  
  // THE WALLET ID: Where the user wants the money sent
  lightningInvoice String           @db.Text 
  
  // THE RECEIPT: The Admin pastes the Tx Hash here after paying
  paymentProof     String?          
  
  status           WithdrawalStatus @default(PENDING)
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  content   String           @db.Text
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}